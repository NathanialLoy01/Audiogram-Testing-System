% VALIDATION - Now allows 0 dB
function validateAndCheckAll(Fig, field, freqName)
    D = Fig.UserData;
    value = field.Value;
    
    field_idx = 0;
    for k = 1:7
        if D.Freq_Fields{k} == field
            field_idx = k;
            break;
        end
    end
    
    if field_idx == 0, return; end
    
    indicator = D.Freq_Indicators{field_idx};
    
    % Check if value is missing (NaN means not entered)
    if isnan(value)
        indicator.Text = '';  % No indicator
        field.BackgroundColor = [1 1 1];  % White background
        D.Fields_Filled(field_idx) = true;  % Consider it filled (as 0)
        D.Fields_Valid(field_idx) = true;   % Valid (0 is normal hearing)
        
    % Accept 0 through 20 (0 is explicitly valid for normal hearing)
    elseif value >= 0 && value <= 20
        indicator.Text = '';  
        field.BackgroundColor = [1 1 1];  
        D.Fields_Filled(field_idx) = true;
        D.Fields_Valid(field_idx) = true;
        
    else
        indicator.Text = 'X';
        indicator.FontColor = [0.8 0 0];
        field.BackgroundColor = [1 0.95 0.95];
        D.Fields_Filled(field_idx) = true;
        D.Fields_Valid(field_idx) = false;
        
        fieldName = field.Tag;
        if ~isfield(D.warned_fields, fieldName)
            msg = sprintf(['Value Exceeds Study Limit\n\n' ...
                'You entered: %.1f dB at %s\n' ...
                'Maximum allowed: 20 dB\n\n' ...
                'Please verify your audiogram values.'], value, freqName);
            uialert(Fig, msg, 'Entry Exceeds Limit', 'Icon', 'warning');
            D.warned_fields.(fieldName) = true;
        end
    end
    
    % Recompute all fields so untouched/blank entries remain valid as 0 dB.
    for k = 1:7
        current_value = D.Freq_Fields{k}.Value;
        D.Fields_Filled(k) = true;
        D.Fields_Valid(k) = isnan(current_value) || (current_value >= 0 && current_value <= 20);
    end
    
    % Always enable Next button if all fields are valid (including empty = 0)
    if all(D.Fields_Valid)
        D.Next_Btn.Enable = 'on';
        D.Validation_Note.Text = 'Ready to continue. (Empty fields = 0 dB = Normal hearing)';
        D.Validation_Note.FontColor = [0.10, 0.48, 0.10];
    else
        D.Next_Btn.Enable = 'off';
        D.Validation_Note.Text = 'Some values exceed 20 dB. Please correct.';
        D.Validation_Note.FontColor = [0.7, 0.1, 0.1];
    end
    
    Fig.UserData = D;
end

function collectAndLaunch(Fig)
    D = Fig.UserData;
    
    audiogram_values = zeros(1, 7);
    for k = 1:7
        val = D.Freq_Fields{k}.Value;
        % Treat empty (NaN) as 0 (normal hearing)
        if isnan(val)
            audiogram_values(k) = 0;
        else
            audiogram_values(k) = val;
        end
    end
    
    freq_names = {'125 Hz', '250 Hz', '500 Hz', '1 kHz', '2 kHz', '4 kHz', '8 kHz'};
    
    % ELIGIBILITY CHECK - No need to check for NaN anymore
    max_value = max(audiogram_values);
    
    if max_value > 20
        exceeding_idx = find(audiogram_values > 20);
        
        msg = sprintf('Study Eligibility Criteria Not Met\n\n');
        msg = [msg 'The following frequencies exceed 20 dB HL:\n\n'];
        
        for i = 1:length(exceeding_idx)
            idx = exceeding_idx(i);
            msg = [msg sprintf('  - %s: %.1f dB\n', freq_names{idx}, audiogram_values(idx))];
        end
        
        msg = [msg sprintf('\n\nThis study focuses on mild hearing loss only.\n')];
        msg = [msg sprintf('We recommend consulting an audiologist.')];
        
        uialert(Fig, msg, 'Not Eligible', 'Icon', 'error');
        logExclusion(Fig, audiogram_values, exceeding_idx);
        return;
    end
    
    % ELIGIBLE - Classify user group
    if max_value < 10
        user_group = 'Normal';
        msg = sprintf('Eligibility Confirmed\n\n');
        msg = [msg 'Group: Normal Listeners\n'];
        msg = [msg sprintf('Max audiogram value: %.1f dB\n\n', max_value)];
        msg = [msg 'You will complete a calibration test to\n'];
        msg = [msg 'determine your starting difficulty level.'];
    else
        user_group = 'Adjusted';
        msg = sprintf('Eligibility Confirmed\n\n');
        msg = [msg 'Group: Adjusted Users\n'];
        msg = [msg sprintf('Max audiogram value: %.1f dB\n\n', max_value)];
        msg = [msg 'Audiogram compensation will be applied\n'];
        msg = [msg 'and gradually reduced as you improve.'];
    end
    
    uialert(Fig, msg, 'Eligible - Group Classified', 'Icon', 'success');
    
    Audiogram = struct();
    for k = 1:7
        Field_Name = sprintf('Hz_%d', D.Audiogram_Frequencies(k));
        Audiogram.(Field_Name) = audiogram_values(k);
    end
    
    logEnrollment(Fig, audiogram_values, user_group);
    launchCalibration(Fig, Audiogram, user_group, max_value);
end

function logExclusion(Fig, values, exceeding)
    try
        D = Fig.UserData;
        exclusion_path = fullfile(D.Project_Dir, 'study_exclusions.txt');
        fid = fopen(exclusion_path, 'a');
        if fid > 0
            fprintf(fid, '\n----------------------------\n');
            fprintf(fid, 'Date: %s\n', datestr(now));
            fprintf(fid, 'Name: %s\n', D.Name_Field.Value);
            fprintf(fid, 'Max: %.1f dB\n', max(values));
            fclose(fid);
        end
    catch
    end
end

function logEnrollment(Fig, values, user_group)
    try
        D = Fig.UserData;
        enrollment_path = fullfile(D.Project_Dir, 'study_enrollments.txt');
        fid = fopen(enrollment_path, 'a');
        if fid > 0
            fprintf(fid, '\n----------------------------\n');
            fprintf(fid, 'Date: %s\n', datestr(now));
            fprintf(fid, 'Name: %s\n', D.Name_Field.Value);
            fprintf(fid, 'Group: %s\n', user_group);
            fprintf(fid, 'Max: %.1f dB, Mean: %.1f dB\n', max(values), mean(values));
            fprintf(fid, 'ELIGIBLE\n');
            fclose(fid);
        end
    catch
    end
end

function launchCalibration(Fig, Audiogram, user_group, max_audiogram_value)
    % Pass to calibration system
    
    D = Fig.UserData;
    User_Name = strtrim(D.Name_Field.Value);
    if isempty(User_Name)
        User_Name = 'unknown';
    end
    
    fprintf('\n========================================\n');
    fprintf('User Classification\n');
    fprintf('========================================\n');
    fprintf('Name: %s\n', User_Name);
    fprintf('Group: %s\n', user_group);
    fprintf('Max Audiogram: %.1f dB\n', max_audiogram_value);
    fprintf('========================================\n\n');
    fprintf('Launching calibration test...\n\n');
    
    session_data = struct();
    session_data.User_Name = User_Name;
    session_data.User_Group = user_group;
    session_data.Max_Audiogram_Value = max_audiogram_value;
    session_data.Audiogram = Audiogram;
    session_data.Audiogram_Data = Audiogram;
    session_data.Entry_Complete = true;
    session_data.Calibration_Complete = false;
    ATS_saveSessionData(session_data);
    
    % Also try assignin for compatibility
    assignin('base', 'User_Name', User_Name);
    assignin('base', 'User_Group', user_group);
    assignin('base', 'Max_Audiogram_Value', max_audiogram_value);
    assignin('base', 'Audiogram_Data', Audiogram);
    
    close(Fig);
    
    % Run critical listening introduction
    ATS_CriticalListeningIntro(10, 'Step2_Calibration_10sec', '');
end

function launchMainProgram(Fig)
    D = Fig.UserData;
    User_Name = strtrim(D.Name_Field.Value);
    if isempty(User_Name)
        User_Name = 'QuickStart';
    end

    session_data = struct();
    session_data.User_Name = User_Name;
    session_data.User_Group = 'Normal';
    session_data.Max_Audiogram_Value = 0;
    session_data.Audiogram = struct('Hz_125', 0, 'Hz_250', 0, 'Hz_500', 0, ...
        'Hz_1000', 0, 'Hz_2000', 0, 'Hz_4000', 0, 'Hz_8000', 0);
    session_data.Audiogram_Data = session_data.Audiogram;
    session_data.Entry_Complete = true;
    session_data.Calibration_Complete = true;
    session_data.Calibration_Boost_Level = 15;
    session_data.Baseline_Audiogram = zeros(1, 8);
    session_data.Audiogram_Gain_Percentage = 0.0;
    ATS_saveSessionData(session_data);

    assignin('base', 'User_Name', session_data.User_Name);
    assignin('base', 'User_Group', session_data.User_Group);
    assignin('base', 'Calibration_Boost_Level', session_data.Calibration_Boost_Level);
    assignin('base', 'Calibration_Complete', true);
    assignin('base', 'Baseline_Audiogram', session_data.Baseline_Audiogram);
    assignin('base', 'Audiogram_Gain_Percentage', session_data.Audiogram_Gain_Percentage);

    close(Fig);
    Step3_Training_System_10sec;
end
